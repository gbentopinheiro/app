generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  admin
  developer
  responsavel
  chef_primeira
  chef_segunda
  carpinteiro
  ferrajeiro
  trolha
  gruista
}

enum AccountType {
  operational
  admin
  developer
}

model AccessProfile {
  id          Int                     @id @default(autoincrement())
  key         String                  @unique @db.VarChar(64)
  name        String                  @db.VarChar(128)
  description String?                 @db.Text
  users       User[]
  permissions AccessProfilePermission[]

  @@map("access_profiles")
}

model Permission {
  id             Int                     @id @default(autoincrement())
  key            String                  @unique @db.VarChar(128)
  name           String                  @db.VarChar(191)
  description    String?                 @db.Text
  category       String                  @db.VarChar(64)
  accessProfiles AccessProfilePermission[]

  @@map("permissions")
}

model AccessProfilePermission {
  id              Int           @id @default(autoincrement())
  accessProfileId Int           @map("access_profile_id")
  permissionId    Int           @map("permission_id")
  accessProfile   AccessProfile @relation(fields: [accessProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission      Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([accessProfileId, permissionId])
  @@map("access_profile_permissions")
}

enum WorkStatus {
  planned
  in_progress
  paused
  completed
}

enum WorkingDay {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum PlanningPublicationState {
  draft
  published
}

model Company {
  id                 Int                @id
  holdingId          Int                @map("holding_id")
  name               String
  slug               String             @unique
  countryCode        String             @map("country_code") @db.Char(2)
  documentMark       String?            @map("document_mark") @db.VarChar(32)
  documentLabel      String?            @map("document_label")
  documentLogoUrl    String?            @map("document_logo_url") @db.Text
  active             Boolean            @default(true)
  clients            Client[]
  works              Work[]
  people             Person[]
  workPlans          WorkPlan[]
  planningWorkspaces PlanningWorkspace[]

  @@map("companies")
}

model Client {
  id          Int      @id
  companyId   Int      @map("company_id")
  name        String
  vatNumber   String?  @map("vat_number") @db.VarChar(64)
  contactName String?  @map("contact_name")
  email       String?  @db.VarChar(191)
  phone       String?  @db.VarChar(64)
  notes       String?  @db.Text
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  works       Work[]

  @@unique([companyId, name])
  @@map("clients")
}

model Person {
  id               Int                  @id
  companyId        Int                  @map("company_id")
  name             String
  price            Decimal              @default(0) @db.Decimal(10, 2)
  monthlyPrice     Decimal              @default(0) @map("monthly_price") @db.Decimal(10, 2)
  isMonthlyBilling Boolean              @default(false) @map("is_monthly_billing")
  role             Role
  chefCategory     String?              @map("chef_category") @db.VarChar(32)
  company                    Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                       User?
  workAssignments            WorkAssignment[]
  planningWorkspaceAssignments PlanningWorkspaceAssignment[]
  workExtraAccessGrants      WorkExtraAccessGrant[]
  workHourlyCosts            WorkPersonHourlyCost[]
  authoredNotes              DailyWorkNote[]
  loginEvents                LoginEvent[]
  documentReminders          PersonDocumentReminder[]

  @@index([companyId, role])
  @@map("people")
}

model Work {
  id                 Int                  @id
  number             Int
  companyId          Int                  @map("company_id")
  clientId           Int                  @map("client_id")
  name               String
  location           String?
  status             WorkStatus           @default(planned)
  budget             Decimal              @default(0) @db.Decimal(12, 2)
  defaultHourlyCost  Decimal              @default(0) @map("default_hourly_cost") @db.Decimal(10, 2)
  startDate          DateTime?            @map("start_date") @db.Date
  endDate            DateTime?            @map("end_date") @db.Date
  notes              String?              @db.Text
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client             Client               @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workingDays        WorkWorkingDay[]
  roleHourlyCosts    WorkRoleHourlyCost[]
  personHourlyCosts  WorkPersonHourlyCost[]
  workAssignments            WorkAssignment[]
  planningWorkspaceAssignments PlanningWorkspaceAssignment[]
  workExtraAccessGrants      WorkExtraAccessGrant[]
  dailyWorkNotes             DailyWorkNote[]

  @@unique([companyId, number])
  @@map("works")
}

model WorkWorkingDay {
  id     Int        @id @default(autoincrement())
  workId Int        @map("work_id")
  day    WorkingDay
  work   Work       @relation(fields: [workId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workId, day])
  @@map("work_working_days")
}

model WorkRoleHourlyCost {
  id         Int     @id @default(autoincrement())
  workId     Int     @map("work_id")
  role       Role
  hourlyCost Decimal @map("hourly_cost") @db.Decimal(10, 2)
  work       Work    @relation(fields: [workId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workId, role])
  @@map("work_role_hourly_costs")
}

model WorkPersonHourlyCost {
  id         Int     @id @default(autoincrement())
  workId     Int     @map("work_id")
  personId   Int     @map("person_id")
  hourlyCost Decimal @map("hourly_cost") @db.Decimal(10, 2)
  work       Work    @relation(fields: [workId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person     Person  @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([workId, personId])
  @@map("work_person_hourly_costs")
}

model WorkPlan {
  id                         Int                @id
  companyId                  Int                @map("company_id")
  date                       DateTime           @db.Date
  company                    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workAssignments            WorkAssignment[]
  publishedPlanningWorkspace PlanningWorkspace? @relation("PublishedWorkPlan")

  @@unique([companyId, date])
  @@map("work_plans")
}

model User {
  id                  Int               @id
  personId            Int?              @unique @map("person_id")
  accessProfileId     Int?              @map("access_profile_id")
  username            String            @unique
  passwordHash        String            @map("password_hash") @db.Text
  role                Role?
  accountType         AccountType       @map("account_type")
  name                String?
  active              Boolean           @default(true)
  deactivatedAt       DateTime?         @map("deactivated_at")
  deletedAt           DateTime?         @map("deleted_at")
  lastLoginAt         DateTime?         @map("last_login_at")
  legacySource        String?           @map("legacy_source") @db.VarChar(64)
  legacySourceId      Int?              @map("legacy_source_id")
  accessProfile       AccessProfile?    @relation(fields: [accessProfileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  person              Person?           @relation(fields: [personId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  submittedAssignments WorkAssignment[] @relation("SubmittedByUser")
  approvedAssignments WorkAssignment[]  @relation("ApprovedByUser")
  developerOverrideEvents DeveloperOverrideEvent[]
  loginEvents         LoginEvent[]

  @@index([accessProfileId])
  @@index([accountType, active])
  @@map("users")
}

model DeveloperOverrideEvent {
  id                Int       @id @default(autoincrement())
  developerUserId   Int?      @map("developer_user_id")
  developerUsername String    @map("developer_username") @db.VarChar(191)
  permissionKeyUsed String    @map("permission_key_used") @db.VarChar(191)
  overrideType      String    @map("override_type") @db.VarChar(64)
  entityType        String    @map("entity_type") @db.VarChar(64)
  entityId          Int?      @map("entity_id")
  targetDate        DateTime? @map("target_date") @db.Date
  action            String    @db.VarChar(64)
  reason            String    @db.Text
  beforeState       Json?     @map("before_state")
  afterState        Json?     @map("after_state")
  result            String    @db.VarChar(32)
  errorMessage      String?   @map("error_message") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  developerUser     User?     @relation(fields: [developerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([developerUserId])
  @@index([createdAt])
  @@index([overrideType, entityType])
  @@map("developer_override_events")
}

model WorkAssignment {
  id                    Int       @id
  workPlanId            Int       @map("work_plan_id")
  workId                Int       @map("work_id")
  personId              Int       @map("person_id")
  hours                 Decimal   @default(0) @db.Decimal(8, 2)
  hoursCreatedAt        DateTime? @map("hours_created_at")
  hoursCreatedByUserId  Int?      @map("hours_created_by_user_id")
  hoursCreatedByName    String?   @map("hours_created_by_name")
  hoursUpdatedAt        DateTime? @map("hours_updated_at")
  hoursUpdatedByUserId  Int?      @map("hours_updated_by_user_id")
  hoursUpdatedByName    String?   @map("hours_updated_by_name")
  dailyHours            Decimal   @default(0) @map("daily_hours") @db.Decimal(8, 2)
  approvedHours         Decimal?  @map("approved_hours") @db.Decimal(8, 2)
  adminApprovedAt       DateTime? @map("admin_approved_at")
  adminApprovedByUserId Int?      @map("admin_approved_by_user_id")
  adminApprovedByName   String?   @map("admin_approved_by_name")
  submitted             Boolean   @default(false)
  submittedAt           DateTime? @map("submitted_at")
  submittedByUserId     Int?      @map("submitted_by_user_id")
  submittedByName       String?   @map("submitted_by_name")
  hourlyCost            Decimal   @default(0) @map("hourly_cost") @db.Decimal(10, 2)
  manualHourlyCost      Boolean   @default(false) @map("manual_hourly_cost")
  notes                 String?   @db.Text
  hasWorkAccess         Boolean   @default(false) @map("has_work_access")
  assignmentPurpose     String    @default("work") @map("assignment_purpose") @db.VarChar(16)
  planningVisible       Boolean   @default(true) @map("planning_visible")
  workPlan              WorkPlan  @relation(fields: [workPlanId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  work                  Work      @relation(fields: [workId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  person                Person    @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedByUser       User?     @relation("SubmittedByUser", fields: [submittedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedByUser        User?     @relation("ApprovedByUser", fields: [adminApprovedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([workPlanId, workId, personId])
  @@index([workPlanId])
  @@index([workId])
  @@index([personId])
  @@map("work_assignments")
}

model PlanningWorkspace {
  id                  Int                        @id @default(autoincrement())
  companyId           Int                        @map("company_id")
  date                DateTime                   @db.Date
  state               PlanningPublicationState   @default(draft)
  publishedWorkPlanId Int?                       @unique @map("published_work_plan_id")
  publishedAt         DateTime?                  @map("published_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  company             Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  publishedWorkPlan   WorkPlan?                  @relation("PublishedWorkPlan", fields: [publishedWorkPlanId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignments         PlanningWorkspaceAssignment[]

  @@unique([companyId, date])
  @@map("planning_workspaces")
}

model PlanningWorkspaceAssignment {
  id                 Int               @id @default(autoincrement())
  workspaceId        Int               @map("workspace_id")
  workId             Int               @map("work_id")
  personId           Int               @map("person_id")
  hourlyCost         Decimal           @default(0) @map("hourly_cost") @db.Decimal(10, 2)
  manualHourlyCost   Boolean           @default(false) @map("manual_hourly_cost")
  notes              String?           @db.Text
  hasWorkAccess      Boolean           @default(false) @map("has_work_access")
  assignmentPurpose  String            @default("work") @map("assignment_purpose") @db.VarChar(16)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  workspace          PlanningWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  work               Work              @relation(fields: [workId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person             Person            @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workspaceId, workId, personId])
  @@index([workspaceId])
  @@index([workId])
  @@index([personId])
  @@map("planning_workspace_assignments")
}

model WorkExtraAccessGrant {
  id        Int      @id @default(autoincrement())
  personId  Int      @map("person_id")
  workId    Int      @map("work_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([personId, workId])
  @@index([personId])
  @@index([workId])
  @@map("work_extra_access_grants")
}

model DailyWorkNote {
  id         Int       @id
  date       DateTime  @db.Date
  workId     Int       @map("work_id")
  authorId   Int?      @map("author_id")
  authorName String?   @map("author_name")
  note       String    @db.Text
  updatedAt  DateTime  @map("updated_at")
  work       Work      @relation(fields: [workId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author     Person?   @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([date, workId])
  @@map("daily_work_notes")
}

model LoginEvent {
  id          Int         @id
  userId      Int?        @map("user_id")
  personId    Int?        @map("person_id")
  username    String
  name        String?
  role        Role?
  accountType AccountType @map("account_type")
  loginAt     DateTime    @map("login_at")
  userAgent   String?     @map("user_agent") @db.Text
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  person      Person?     @relation(fields: [personId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([loginAt])
  @@map("login_events")
}

model LoginAttempt {
  username     String    @id @db.VarChar(191)
  failedAt     Json      @map("failed_at")
  blockedUntil DateTime? @map("blocked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("login_attempts")
}

model AuditTrailEvent {
  id           String    @id @db.VarChar(48)
  timestamp    DateTime
  username     String    @db.VarChar(191)
  action       String    @db.VarChar(64)
  entity       String    @db.VarChar(64)
  entityId     Int?      @map("entity_id")
  details      Json
  result       String    @db.VarChar(32)
  errorMessage String?   @map("error_message") @db.Text

  @@index([timestamp])
  @@index([username])
  @@index([action, entity])
  @@map("audit_trail_events")
}

model Material {
  id              Int      @id
  name            String   @db.VarChar(191)
  reference       String?  @unique @db.VarChar(191)
  category        String?  @db.VarChar(191)
  unit            String   @default("un") @db.VarChar(16)
  quantity        Decimal  @default(0) @db.Decimal(10, 2)
  minimumQuantity Decimal  @default(0) @map("minimum_quantity") @db.Decimal(10, 2)
  location        String?  @db.VarChar(191)
  supplier        String?  @db.VarChar(191)
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("materials")
}

model PersonDocumentReminder {
  id             Int      @id
  personId       Int      @map("person_id")
  name           String   @db.VarChar(191)
  expirationDate DateTime @map("expiration_date") @db.Date
  warningDays    Int      @default(30) @map("warning_days")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([personId])
  @@index([expirationDate])
  @@map("person_document_reminders")
}

model CalendarEvent {
  id                      Int       @id
  date                    DateTime  @db.Date
  title                   String    @db.VarChar(191)
  type                    String    @db.VarChar(32)
  transport               String    @db.VarChar(32)
  airport                 String    @db.VarChar(64)
  destination             String?   @db.VarChar(191)
  departureDate           DateTime? @map("departure_date") @db.Date
  arrivalDate             DateTime? @map("arrival_date") @db.Date
  departureTime           String?   @map("departure_time") @db.VarChar(8)
  arrivalTime             String?   @map("arrival_time") @db.VarChar(8)
  outboundFlightReference String?   @map("outbound_flight_reference") @db.VarChar(64)
  returnFlightReference   String?   @map("return_flight_reference") @db.VarChar(64)
  color                   String    @db.VarChar(16)
  createdBy               String?   @map("created_by") @db.VarChar(191)
  createdAt               DateTime  @map("created_at")
  updatedAt               DateTime  @map("updated_at")

  @@index([date])
  @@index([type])
  @@map("calendar_events")
}

model CalendarNotificationState {
  username String   @id @db.VarChar(191)
  seenAt   DateTime @map("seen_at")

  @@map("calendar_notification_states")
}

model FeatureFlag {
  key       String   @id @db.VarChar(64)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

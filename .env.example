## Bentix environment example
## Use apenas um perfil por ambiente real.
## Nunca guardar secrets reais neste ficheiro.
##
## Mapeamento operacional:
## - "SESSION_SECRET" -> AUTH_SECRET (nome real usado pelo codigo)
## - "PAYLOAD_KEY" -> LOGIN_PUBLIC_KEY_PEM + LOGIN_PRIVATE_KEY_PEM (par de chaves usado pelo codigo)

## LOCAL
## - Frontend local em localhost
## - REST API local em localhost
## - MySQL local
## - NEXT_PUBLIC_APP_ENV=local para usar a config local e continuar em /api/...
## - SESSION_SECRET => AUTH_SECRET
## - PAYLOAD_KEY => LOGIN_PUBLIC_KEY_PEM + LOGIN_PRIVATE_KEY_PEM
NODE_ENV="development"
BENTIX_DATA_SOURCE="mysql"
DATABASE_URL="mysql://bentix_app:CHANGE_ME@localhost:3306/bentix_local"
NEXT_PUBLIC_APP_ENV="local"
NEXT_PUBLIC_API_BASE_URL=""
AUTH_SECRET="CHANGE_ME_DEV_SESSION_SECRET"
SESSION_COOKIE_DOMAIN=""
LOGIN_PUBLIC_KEY_PEM=""
LOGIN_PRIVATE_KEY_PEM=""

## DEV
## - Frontend em https://dev.bentixapp.com
## - REST API em https://api-dev.bentixapp.com
## - SESSION_SECRET => AUTH_SECRET
## - PAYLOAD_KEY => LOGIN_PUBLIC_KEY_PEM + LOGIN_PRIVATE_KEY_PEM
# NODE_ENV="production"
# BENTIX_DATA_SOURCE="mysql"
# DATABASE_URL="mysql://bentix_app:CHANGE_ME@db-dev:3306/bentix_dev"
# NEXT_PUBLIC_APP_ENV="dev"
# NEXT_PUBLIC_API_BASE_URL=""
# AUTH_SECRET="CHANGE_ME_DEV_SESSION_SECRET"
# SESSION_COOKIE_DOMAIN=".bentixapp.com"
# LOGIN_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# LOGIN_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

## PROD
## - Frontend em https://bentixapp.com
## - REST API em https://api.bentixapp.com
## - SESSION_SECRET => AUTH_SECRET
## - PAYLOAD_KEY => LOGIN_PUBLIC_KEY_PEM + LOGIN_PRIVATE_KEY_PEM

APP_CONTAINER_NAME=bentix-test-app
DB_CONTAINER_NAME=bentix-test-db

APP_PORT=3100
DB_PORT=3307

NODE_ENV=production
BENTIX_DATA_SOURCE=mysql

DB_NAME=bentix_test
DB_USER=bentix_app
DB_PASSWORD=CHANGE_ME_TEST_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_TEST_ROOT_PASSWORD
DATABASE_URL=mysql://bentix_app:CHANGE_ME_TEST_DB_PASSWORD@db:3306/bentix_test

NEXT_PUBLIC_API_BASE_URL=https://api-test.bentix.pt

# SESSION_SECRET no codigo atual corresponde a AUTH_SECRET
AUTH_SECRET=CHANGE_ME_TEST_SESSION_SECRET

# PAYLOAD_KEY no codigo atual corresponde ao par abaixo
LOGIN_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nPASTE_TEST_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----
LOGIN_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nPASTE_TEST_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----

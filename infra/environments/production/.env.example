APP_CONTAINER_NAME=bentix-production-app
DB_CONTAINER_NAME=bentix-production-db

APP_PORT=3300
DB_PORT=3309

NODE_ENV=production
BENTIX_DATA_SOURCE=mysql

DB_NAME=bentix_prod
DB_USER=bentix_app
DB_PASSWORD=CHANGE_ME_PRODUCTION_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_PRODUCTION_ROOT_PASSWORD
DATABASE_URL=mysql://bentix_app:CHANGE_ME_PRODUCTION_DB_PASSWORD@db:3306/bentix_prod

NEXT_PUBLIC_APP_ENV=prod

# Override opcional. Se vazio, usa https://api.bentixapp.com via config/app.prod.js.
NEXT_PUBLIC_API_BASE_URL=

# SESSION_SECRET no codigo atual corresponde a AUTH_SECRET
AUTH_SECRET=CHANGE_ME_PRODUCTION_SESSION_SECRET

# PAYLOAD_KEY no codigo atual corresponde ao par abaixo
LOGIN_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nPASTE_PRODUCTION_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----
LOGIN_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nPASTE_PRODUCTION_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----

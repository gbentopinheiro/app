WEB_CONTAINER_NAME=bentix-dev-web
API_CONTAINER_NAME=bentix-dev-api
DB_CONTAINER_NAME=bentix-dev-db

WEB_PORT=3100
API_PORT=3101
DB_PORT=3307

NODE_ENV=production
BENTIX_DATA_SOURCE=mysql

DB_NAME=bentix_dev
DB_USER=bentix_app
DB_PASSWORD=CHANGE_ME_DEV_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DEV_ROOT_PASSWORD
DATABASE_URL=mysql://bentix_app:CHANGE_ME_DEV_DB_PASSWORD@db:3306/bentix_dev

# Perfil publico usado no build do frontend.
NEXT_PUBLIC_APP_ENV=dev

# Override opcional. Se vazio, usa https://api-dev.bentixapp.com via config/app.dev.js.
NEXT_PUBLIC_API_BASE_URL=

# SESSION_SECRET no codigo atual corresponde a AUTH_SECRET
AUTH_SECRET=CHANGE_ME_DEV_SESSION_SECRET
SESSION_COOKIE_DOMAIN=.bentixapp.com

# PAYLOAD_KEY no codigo atual corresponde ao par abaixo
LOGIN_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nPASTE_DEV_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----
LOGIN_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nPASTE_DEV_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----
